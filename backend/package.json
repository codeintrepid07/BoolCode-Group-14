{
  "name": "digital-circuits-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Boolean minimization, universal-gate synthesis, and API for the Digital Circuits project.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
